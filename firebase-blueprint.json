{
  "entities": {
    "Expense": {
      "title": "Expense",
      "description": "A single expense entry for the construction project.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "local": { "type": "string" },
        "value": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "category": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "installments": { "type": "number" },
        "donor": { "type": "string" },
        "observation": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["local", "value", "date", "category", "paymentMethod", "createdAt", "createdBy"]
    },
    "Income": {
      "title": "Income",
      "description": "A single income entry (financing received).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "value": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["description", "value", "date", "createdAt", "createdBy"]
    },
    "Payment": {
      "title": "Payment",
      "description": "A payment made by a person to cover their share.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "person": { "type": "string" },
        "value": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["person", "value", "date", "createdAt", "createdBy"]
    }
  },
  "firestore": {
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Collection of all expenses."
    },
    "/incomes/{incomeId}": {
      "schema": { "$ref": "#/entities/Income" },
      "description": "Collection of all incomes."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "Collection of all payments."
    }
  }
}
